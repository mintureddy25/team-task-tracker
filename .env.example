# Copy to .env and adjust if needed.
# Defaults match docker-compose.yml — `docker compose up` works out of the box.

# ─── Server ───
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Database (MySQL) ───
# Inside docker network the host is the service name `mysql`.
# For local dev outside docker, use 127.0.0.1.
DATABASE_URL="mysql://taskuser:taskpass@mysql:3306/tasktracker"

# ─── Redis ───
REDIS_URL="redis://redis:6379"

# ─── JWT ───
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Caching ───
CACHE_TTL_SECONDS=60

# ─── CORS (comma-separated) ───
# 5173 = Vite dev server (frontend/)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
