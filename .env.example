# For `docker compose up` you DON'T need this file — the compose stack has its
# own baked-in config. Copy this to `.env` only for running the API directly
# with `npm run dev`. Defaults below point at the docker-compose MySQL/Redis
# (start them with `docker compose up mysql redis`), but any MySQL/Redis works
# — local or a managed cloud service (Aiven, Redis Cloud, …).

# ─── Server ───
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ─── Database (MySQL) ───
# Matches docker-compose. connection_limit pins the Prisma pool (containers can
# detect 0 CPUs and default to a pool of 1, which times out under parallel load).
# Cloud example (Aiven, SSL): mysql://USER:PASS@HOST:PORT/tasktracker?sslaccept=accept_invalid_certs&connection_limit=5
DATABASE_URL="mysql://taskuser:taskpass@127.0.0.1:3306/tasktracker?connection_limit=5&pool_timeout=20"

# ─── Redis ───
# Cloud example (Redis Cloud): redis://default:PASS@HOST:PORT
REDIS_URL="redis://127.0.0.1:6379"

# ─── JWT ───
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Caching ───
CACHE_TTL_SECONDS=60

# ─── CORS (comma-separated) ───
# 5173 = Vite dev server (frontend/)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
