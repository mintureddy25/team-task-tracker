# Copy to .env and fill in your own cloud MySQL + Redis connection strings.
# `docker compose up --build` runs the API only and reads these values from .env.

# ─── Server ───
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Database (MySQL) ───
# Bring your own MySQL (e.g. Aiven, PlanetScale, local). The DB must already exist.
# Example (Aiven, SSL): mysql://USER:PASS@HOST:PORT/tasktracker?sslaccept=accept_invalid_certs
DATABASE_URL="mysql://USER:PASS@HOST:PORT/tasktracker"

# ─── Redis ───
# Bring your own Redis (e.g. Redis Cloud, Upstash, local).
# Example (Redis Cloud): redis://default:PASS@HOST:PORT
REDIS_URL="redis://USER:PASS@HOST:PORT"

# ─── JWT ───
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Caching ───
CACHE_TTL_SECONDS=60

# ─── CORS (comma-separated) ───
# 5173 = Vite dev server (frontend/)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
